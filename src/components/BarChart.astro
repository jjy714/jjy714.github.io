---
// Dependency-free SVG grouped bar chart. Labels and values are language
// neutral; the bilingual title/note live in HTML around the SVG.
import { siteConfig } from "../config";
interface Props {
  labels: string[];
  series: { name: string; values: number[] }[];
  max: number;
  digits?: number;
}
const { labels, series, max, digits = 2 } = Astro.props;
const W = 640, H = 300, padL = 44, padR = 12, padT = 20, padB = 44;
const plotW = W - padL - padR, plotH = H - padT - padB;
const colors = series.length > 1 ? ["#9ca3af", siteConfig.accentColor] : [siteConfig.accentColor];
const groupW = plotW / labels.length;
const barW = Math.min(56, (groupW * 0.7) / series.length);
const y = (v: number) => padT + plotH - (v / max) * plotH;
const ticks = [0, 0.25, 0.5, 0.75, 1].map((t) => t * max);
---

<figure class="my-2">
  <svg viewBox={`0 0 ${W} ${H}`} role="img" class="w-full h-auto">
    {ticks.map((t) => (
      <g>
        <line x1={padL} x2={W - padR} y1={y(t)} y2={y(t)} stroke="#e5e7eb" />
        <text x={padL - 6} y={y(t) + 4} text-anchor="end" font-size="11" fill="#6b7280">
          {Number.isInteger(t) ? t : t.toFixed(max <= 1 ? 2 : 0)}
        </text>
      </g>
    ))}
    {labels.map((label, i) => (
      <g>
        {series.map((s, j) => {
          const x = padL + groupW * i + (groupW - barW * series.length) / 2 + barW * j;
          const v = s.values[i];
          return (
            <g>
              <rect x={x} y={y(v)} width={barW - 4} height={padT + plotH - y(v)} fill={colors[j]} rx="3" />
              <text x={x + (barW - 4) / 2} y={y(v) - 5} text-anchor="middle" font-size="11" fill="#374151">
                {v.toFixed(digits)}
              </text>
            </g>
          );
        })}
        <text x={padL + groupW * i + groupW / 2} y={H - padB + 18} text-anchor="middle" font-size="12" fill="#374151">
          {label}
        </text>
      </g>
    ))}
  </svg>
  {series.length > 1 && (
    <figcaption class="flex gap-4 justify-center text-xs text-gray-600 mt-1">
      {series.map((s, j) => (
        <span class="inline-flex items-center gap-1.5">
          <span class="inline-block w-3 h-3 rounded-sm" style={`background:${colors[j]}`} />
          {s.name}
        </span>
      ))}
    </figcaption>
  )}
</figure>
