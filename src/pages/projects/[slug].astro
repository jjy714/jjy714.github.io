---
import { projectDetails } from "../../data/projectDetails";
import { siteConfig } from "../../config";
import BarChart from "../../components/BarChart.astro";
import "../../styles/global.css";

export function getStaticPaths() {
  return projectDetails.map((detail) => ({ params: { slug: detail.slug }, props: { detail } }));
}
const { detail } = Astro.props;
const accent = siteConfig.accentColor;
---

<html lang="en" data-lang="en">
  <head>
    <script is:inline>
      (function(){var q=new URLSearchParams(location.search).get('lang');var l=q||localStorage.getItem('preferred-lang');if(l==='ko'||l==='en')document.documentElement.setAttribute('data-lang',l)})();
    </script>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={detail.summary.en} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <title>{detail.title.en} - {siteConfig.en.name}</title>
  </head>
  <body class="bg-white">
    <nav class="max-w-3xl mx-auto px-6 pt-6 flex items-center justify-between">
      <a href="/#projects" class="text-sm font-medium text-gray-700 hover:text-black">
        <span data-en>← All projects</span>
        <span data-ko>← 프로젝트 목록</span>
      </a>
      <button
        id="lang-toggle"
        aria-label="Toggle language"
        class="text-gray-700 hover:text-black transition-colors font-medium border border-gray-400 hover:border-black rounded px-2.5 py-1 text-sm"
      >
        <span data-en>KO</span>
        <span data-ko>EN</span>
      </button>
    </nav>

    <main class="max-w-3xl mx-auto px-6 py-10 sm:py-14">
      <p class="text-xs sm:text-sm font-mono text-gray-500">
        <span data-en>{detail.tag.en}</span>
        <span data-ko>{detail.tag.ko}</span>
      </p>
      <h1 class="text-3xl sm:text-4xl font-bold text-gray-900 mt-2">
        <span data-en>{detail.title.en}</span>
        <span data-ko>{detail.title.ko}</span>
      </h1>
      <div class="w-[75px] h-[5px] mt-3 rounded-full" style={`background-color:${accent}`}></div>
      <p class="text-lg text-gray-600 leading-relaxed mt-6">
        <span data-en>{detail.summary.en}</span>
        <span data-ko>{detail.summary.ko}</span>
      </p>
      <div class="flex flex-wrap gap-1.5 sm:gap-2 pt-4">
        {detail.skills.map((skill) => (
          <span class="px-2.5 sm:px-3 py-1 bg-gray-900 text-white rounded-md text-xs sm:text-sm font-medium">{skill}</span>
        ))}
      </div>

      <div class="mt-12 space-y-12">
        {detail.sections.map((section) => (
          <section>
            <h2 class="text-xl sm:text-2xl font-bold text-gray-900">
              <span data-en>{section.heading.en}</span>
              <span data-ko>{section.heading.ko}</span>
            </h2>
            {section.paragraphs?.map((p) => (
              <p class="text-base sm:text-lg text-gray-600 leading-relaxed mt-3">
                <span data-en>{p.en}</span>
                <span data-ko>{p.ko}</span>
              </p>
            ))}
            {section.bullets && (
              <ul class="mt-3 list-disc pl-5 space-y-2 text-base sm:text-lg text-gray-600 leading-relaxed marker:text-gray-400">
                {section.bullets.map((b) => (
                  <li>
                    <span data-en>{b.en}</span>
                    <span data-ko>{b.ko}</span>
                  </li>
                ))}
              </ul>
            )}
            {section.chartIndex !== undefined && (
              <div class="mt-6 p-4 sm:p-6 bg-gray-50 border border-gray-200 rounded-xl">
                <h3 class="text-sm font-semibold text-gray-800">
                  <span data-en>{detail.charts[section.chartIndex].title.en}</span>
                  <span data-ko>{detail.charts[section.chartIndex].title.ko}</span>
                </h3>
                <BarChart
                  labels={detail.charts[section.chartIndex].labels}
                  series={detail.charts[section.chartIndex].series}
                  max={detail.charts[section.chartIndex].max}
                  digits={detail.charts[section.chartIndex].digits}
                />
                {detail.charts[section.chartIndex].note && (
                  <p class="text-xs text-gray-500 mt-2">
                    <span data-en>{detail.charts[section.chartIndex].note?.en}</span>
                    <span data-ko>{detail.charts[section.chartIndex].note?.ko}</span>
                  </p>
                )}
              </div>
            )}
          </section>
        ))}
      </div>
    </main>
    <script>
      import "../../scripts/langToggle.ts";
    </script>
  </body>
</html>
